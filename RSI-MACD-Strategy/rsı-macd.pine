//@version=5
strategy("RSI + MACD Strategy", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// ---- RSI Settings ----
rsiLength = input.int(14, title="RSI Length")
rsiOverbought = input.int(70, title="RSI Overbought Level")
rsiOversold = input.int(30, title="RSI Oversold Level")

// ---- MACD Settings ----
fastLength = input.int(12, title="MACD Fast Length")
slowLength = input.int(26, title="MACD Slow Length")
macdSmaLength = input.int(9, title="MACD Signal Length")

// ---- Calculate Indicators ----
price = close
vrsi = ta.rsi(price, rsiLength)

[macdLine, signalLine, _] = ta.macd(price, fastLength, slowLength, macdSmaLength)

// ---- Strategy Logic ----
// Entry conditions: 
// 1. RSI is oversold (below 30) or crossing up
// 2. MACD crosses up its signal line
longCondition = ta.crossover(macdLine, signalLine) and (vrsi < rsiOversold or ta.crossover(vrsi, rsiOversold))

// Exit conditions:
// 1. RSI is overbought (above 70) 
// 2. MACD crosses down its signal line
shortCondition = ta.crossunder(macdLine, signalLine) and (vrsi > rsiOverbought or ta.crossunder(vrsi, rsiOverbought))

// ---- Execute Trades ----
if (longCondition)
    strategy.entry("Long Entry", strategy.long, comment="Buy")

if (shortCondition)
    // Here we can either go short or just close the long position. Entering to close:
    strategy.close("Long Entry", comment="Sell/Close")

// ---- Visuals ----
plotshape(series=longCondition, title="Buy Signal", location=location.belowbar, color=color.green, style=shape.labelup, text="BUY")
plotshape(series=shortCondition, title="Sell Signal", location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL")
